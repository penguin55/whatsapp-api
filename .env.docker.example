PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# The hostname is the PostgreSQL network alias from docker-compose.postgres.yml.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=whatsapp_api
DB_USER=app_owner
DB_PASS=replace-with-the-same-postgres-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate a separate random value of at least 32 characters.
API_SECRET=replace-with-a-long-random-production-secret
CORS_ORIGINS=

# Required on the first startup when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

LOG_LEVEL=info
WA_RECONNECT_INTERVAL=5000
WA_MAX_RECONNECT_RETRIES=5

# Optional host binding used by docker-compose.yml.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
