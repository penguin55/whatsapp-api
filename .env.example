# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_api
DB_USER=postgres
DB_PASS=your_password_here
DB_SSL=false
# Keep true for managed PostgreSQL with a trusted certificate.
DB_SSL_REJECT_UNAUTHORIZED=true

# API Security
# Used to sign browser sessions. Generate at least 32 random bytes and keep it private.
API_SECRET=replace-with-a-long-random-production-secret
# Optional comma-separated browser origins allowed to call the API.
# Leave empty when the dashboard and API share the same origin.
CORS_ORIGINS=

# Used only when the users table is empty to create the initial administrator.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Logging
LOG_LEVEL=info

# WhatsApp Configuration
WA_RECONNECT_INTERVAL=5000
WA_MAX_RECONNECT_RETRIES=5
