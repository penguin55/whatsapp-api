{
  "name": "wa-gateway",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@wa-gateway/api",
    "dev:api": "npm run dev --workspace=@wa-gateway/api",
    "dev:dashboard": "npm run dev --workspace=@wa-gateway/dashboard",
    "build": "npm run build --workspace=@wa-gateway/dashboard && npm run build --workspace=@wa-gateway/api",
    "start": "npm run start --workspace=@wa-gateway/api",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
